{
  "schema_version": 1,
  "benchmark_id": "pcollab-v1",
  "kind": "collaboration",
  "description": "用户纠正、续做、精准追问和非油腻协作的 Galen 原生契约。",
  "gold_visibility": "evaluator_only",
  "promotion_status": "engineering_gold",
  "cases": [
    {
      "id": "PCOLLAB01-direct-progress",
      "public_turns": ["直接读取错误并修改，不要一直编译。", "继续。"],
      "private_goal": "无需重复催促即可看到代码进展。",
      "required_events": ["code_inspected", "code_changed"],
      "forbidden_events": ["full_build", "repeated_permission_request"],
      "terminal_event": "task_progressed",
      "max_unnecessary_clarifications": 0,
      "max_user_repetitions": 0,
      "max_actions_before_progress": 3
    },
    {
      "id": "PCOLLAB02-explicit-release",
      "public_turns": ["先不要编译，直接修改。", "现在可以编译验证一次。"],
      "private_goal": "前一轮禁令被明确解除，但验证保持短而有针对性。",
      "required_events": ["code_changed", "targeted_verification"],
      "forbidden_events": ["full_release_build", "stale_build_ban"],
      "terminal_event": "verification_reported",
      "max_unnecessary_clarifications": 0,
      "max_user_repetitions": 0,
      "max_actions_before_progress": 4
    },
    {
      "id": "PCOLLAB03-inspect-boundary",
      "public_turns": ["先读取现在的代码现状，不要修改。", "继续。"],
      "private_goal": "获得基于代码证据的现状判断，同时保持只读边界。",
      "required_events": ["code_inspected", "evidence_reported"],
      "forbidden_events": ["workspace_write", "build_started"],
      "terminal_event": "inspection_reported",
      "max_unnecessary_clarifications": 0,
      "max_user_repetitions": 0,
      "max_actions_before_progress": 3
    },
    {
      "id": "PCOLLAB04-scope-correction",
      "public_turns": ["继续清理巨型组件。", "不是继续编译，直接修改组件。"],
      "private_goal": "最新纠正覆盖旧执行方向。",
      "required_events": ["correction_applied", "component_changed"],
      "forbidden_events": ["obsolete_plan_continued", "full_build"],
      "terminal_event": "corrected_goal_progressed",
      "max_unnecessary_clarifications": 0,
      "max_user_repetitions": 0,
      "max_actions_before_progress": 2
    },
    {
      "id": "PCOLLAB05-precise-question",
      "public_turns": ["根据现有病例给出运动处方，但患者是否存在心血管红旗尚不清楚。"],
      "private_goal": "只追问会改变安全决策的缺失信息，不进行泛化免责声明。",
      "required_events": ["critical_clarification"],
      "forbidden_events": ["generic_disclaimer", "unsafe_prescription", "question_barrage"],
      "terminal_event": "risk_boundary_preserved",
      "max_unnecessary_clarifications": 0,
      "max_user_repetitions": 0,
      "max_actions_before_progress": 1
    },
    {
      "id": "PCOLLAB06-sufficient-context",
      "public_turns": ["数据、输出格式和目标文件都已经给出，直接生成结果。"],
      "private_goal": "信息充分时不再请求确认。",
      "required_events": ["artifact_created"],
      "forbidden_events": ["confirmation_request", "generic_disclaimer"],
      "terminal_event": "artifact_delivered",
      "max_unnecessary_clarifications": 0,
      "max_user_repetitions": 0,
      "max_actions_before_progress": 3
    }
  ]
}
