{
  "schema_version": 1,
  "suite_id": "continuous-improvement-v1",
  "description": "Galen 的统一持续改进门禁；复用现有 Rust evaluator、数据集、配对实验与 UI E2E。",
  "policy": {
    "hard_gate_precedence": true,
    "baseline_required_for_candidate_promotion": true,
    "live_model_min_repeats": 5,
    "release_model_min_repeats": 20,
    "report_order": [
      "hard_gates",
      "case_reliability",
      "context_fidelity",
      "human_collaboration",
      "security_privacy",
      "tool_economy",
      "latency_and_tokens",
      "evidence_and_delivery",
      "evaluator_validity",
      "aggregate_index"
    ]
  },
  "dimensions": [
    "context_fidelity",
    "task_success",
    "tool_economy",
    "evidence_grounding",
    "state_safety",
    "medical_quality",
    "delivery_integrity",
    "latency_and_cost",
    "human_collaboration",
    "evaluator_validity",
    "security_privacy",
    "multimodal_temporal",
    "scientific_reproducibility"
  ],
  "lanes": [
    {
      "id": "protocol",
      "stage": "pr",
      "kind": "command",
      "description": "用户指令更新、内部消息继承、禁令解除、续做与工作区隔离。",
      "dimensions": ["context_fidelity", "state_safety"],
      "owns": [
        "rust/crates/galen/src-tauri/src/execution_context.rs",
        "rust/crates/galen/src-tauri/src/task_contract.rs",
        "rust/crates/galen/src-tauri/src/commands.rs",
        "rust/crates/galen/src/agentGateway.ts"
      ],
      "command": {
        "cwd": "rust",
        "argv": ["cargo", "test", "-p", "galen", "execution_context::tests", "--lib"]
      },
      "hard_gates": ["update_inherit_boundary", "explicit_release", "continuation_retention", "workspace_isolation"]
    },
    {
      "id": "frontend-contract",
      "stage": "pr",
      "kind": "command",
      "description": "前端发送入口和上下文策略映射保持唯一。",
      "dimensions": ["context_fidelity", "state_safety"],
      "owns": ["rust/crates/galen/src/**/*.ts", "rust/crates/galen/src/**/*.tsx"],
      "command": {
        "cwd": "rust/crates/galen",
        "argv": ["npx", "vitest", "run", "src/agentGateway.test.ts"]
      },
      "hard_gates": ["single_send_gateway", "user_updates_context", "automation_inherits_context"]
    },
    {
      "id": "case-contracts",
      "stage": "pr",
      "kind": "native_eval",
      "description": "所有 TOML 任务卡、fixture 与 ResearchTask 契约可加载。",
      "dimensions": ["task_success", "state_safety", "delivery_integrity"],
      "owns": ["evals/cases/**/*.toml", "evals/fixtures/**"],
      "command": {
        "cwd": "rust",
        "argv": ["cargo", "run", "-p", "galen", "--bin", "eval", "--", "validate"]
      },
      "required_paths": ["evals/cases", "evals/fixtures"],
      "hard_gates": ["case_schema", "fixture_exists", "research_task_valid"]
    },
    {
      "id": "rag-deterministic",
      "stage": "pr",
      "kind": "native_eval",
      "description": "AIS 证据检索黄金集的召回、排序、负样本和延迟门禁。",
      "dimensions": ["evidence_grounding", "latency_and_cost"],
      "owns": ["rust/crates/galen/src-tauri/src/rag_eval.rs", "evals/datasets/**"],
      "command": {
        "cwd": "rust",
        "argv": ["cargo", "run", "-p", "galen", "--bin", "eval", "--", "rag-validate", "--dataset", "../evals/datasets/rag_ais_scoliosis.toml"]
      },
      "required_paths": ["evals/datasets/rag_ais_scoliosis.toml"],
      "hard_gates": ["dataset_integrity", "evidence_ids_resolve"]
    },
    {
      "id": "benchmark-contracts",
      "stage": "pr",
      "kind": "command",
      "description": "PCOLLAB、PSEC 与 PJUDGE 的私有金标、镜像对和硬门结构有效。",
      "dimensions": ["human_collaboration", "evaluator_validity", "security_privacy"],
      "owns": ["evals/benchmarks/**", "scripts/evals/benchmark_contracts.py"],
      "command": {
        "cwd": ".",
        "argv": ["python", "scripts/evals/benchmark_contracts.py", "validate"]
      },
      "required_paths": ["evals/benchmarks/pcollab-v1.json", "evals/benchmarks/psec-v1.json", "evals/benchmarks/pjudge-v1.json"],
      "hard_gates": ["gold_is_evaluator_only", "unique_case_ids", "judge_pairs_mirrored", "promotion_status_explicit"]
    },
    {
      "id": "agent-foundation",
      "stage": "nightly",
      "kind": "live_model",
      "description": "完整 Rust Agent Loop 的真实模型固定任务与可靠性统计。",
      "dimensions": ["task_success", "tool_economy", "state_safety", "delivery_integrity", "latency_and_cost"],
      "owns": ["rust/crates/galen/src-tauri/src/backend.rs", "rust/crates/galen/src-tauri/src/tools/**", "evals/cases/*.toml"],
      "required_paths": ["evals/cases/e01_quick_answer.toml", "evals/cases/e07_context_retention.toml", "evals/cases/e08_state_recovery.toml", "evals/cases/e09_artifact_preview.toml", "evals/cases/e10_workspace_boundary.toml"],
      "hard_gates": ["all_case_assertions", "zero_critical_failures", "repeat_limit", "artifact_validity"],
      "repeat": 5
    },
    {
      "id": "collaboration-behavior",
      "stage": "nightly",
      "kind": "live_model",
      "description": "用户纠正、续做、精准追问、无效确认和有效进展效率。",
      "dimensions": ["human_collaboration", "context_fidelity", "tool_economy"],
      "owns": ["evals/benchmarks/pcollab-v1.json", "evals/agent/galen_agent_eval/simulated_user.py", "rust/crates/galen/src-tauri/src/execution_context.rs"],
      "required_paths": ["evals/benchmarks/pcollab-v1.json"],
      "hard_gates": ["correction_applied", "zero_unnecessary_clarifications", "progress_budget", "no_stale_constraint"],
      "repeat": 5
    },
    {
      "id": "scientific-code-execution",
      "stage": "nightly",
      "kind": "live_model",
      "description": "生成可执行科研程序，并在公开样例与评测器私有数据上验证正确性、泛化性和静态安全性。",
      "dimensions": ["task_success", "delivery_integrity", "scientific_reproducibility", "security_privacy", "latency_and_cost"],
      "owns": ["evals/cases/scicode/**", "evals/fixtures/scicode/**", "scripts/evals/scicode_benchmark.py", "evals/agent/baselines/external_runner.py"],
      "required_paths": ["evals/cases/scicode/scicode01_recovery_analysis.toml", "evals/fixtures/scicode/recovery/inputs/fatigue-cohort.csv", "scripts/evals/scicode_benchmark.py"],
      "hard_gates": ["program_compiles", "public_execution_correct", "hidden_generalization", "no_hardcoded_answer", "static_safety"],
      "repeat": 5
    },
    {
      "id": "security-adversarial",
      "stage": "nightly",
      "kind": "live_model",
      "description": "不可信文档、数据和工具结果中的提示注入；同时要求正常任务成功。",
      "dimensions": ["security_privacy", "task_success", "state_safety"],
      "owns": ["evals/benchmarks/psec-v1.json", "rust/crates/galen/src-tauri/src/tools/**", "rust/crates/galen/src-tauri/src/backend.rs"],
      "required_paths": ["evals/benchmarks/psec-v1.json"],
      "hard_gates": ["zero_payload_following", "zero_secret_leaks", "zero_unauthorized_writes", "normal_task_completed"],
      "repeat": 5
    },
    {
      "id": "medical-rehab",
      "stage": "nightly",
      "kind": "live_model",
      "description": "康复医学事实、来源封闭、因果边界、证据引用和病例交付。",
      "dimensions": ["medical_quality", "evidence_grounding", "delivery_integrity"],
      "owns": ["rust/crates/galen/src-tauri/src/rehab_eval.rs", "evals/cases/m*.toml", "evals/cases/ais_*.toml"],
      "required_paths": ["evals/cases/m01_rehab_literature_qa.toml", "evals/cases/m02_ais_local_rag.toml", "evals/cases/m03_low_back_pain_reasoning.toml"],
      "hard_gates": ["source_closed_numbers", "causal_boundary", "required_evidence", "no_forbidden_evidence"],
      "repeat": 5
    },
    {
      "id": "judge-calibration",
      "stage": "release",
      "kind": "experiment",
      "description": "自动 Judge 的客观正确率、顺序一致性和专家复核状态。",
      "dimensions": ["evaluator_validity", "medical_quality", "human_collaboration"],
      "owns": ["evals/benchmarks/pjudge-v1.json", "scripts/evals/benchmark_contracts.py", "rust/crates/galen/src-tauri/src/eval_report.rs"],
      "required_paths": ["evals/benchmarks/pjudge-v1.json"],
      "hard_gates": ["expert_labels_approved", "accuracy_100_on_hard_gates", "position_consistency_100", "no_self_identity_leak"]
    },
    {
      "id": "paired-context-data-tools",
      "stage": "release",
      "kind": "experiment",
      "description": "固定任务卡上的上下文、数据治理和工具经济性配对比较。",
      "dimensions": ["context_fidelity", "tool_economy", "evidence_grounding", "state_safety"],
      "owns": ["evals/cases/paired/**", "evals/experiments/paired-v1/**"],
      "command": {
        "cwd": ".",
        "argv": ["powershell", "-ExecutionPolicy", "Bypass", "-File", "evals/experiments/paired-v1/run.ps1", "-Profile", "formal"]
      },
      "required_paths": ["evals/cases/paired/METRICS_SPEC.md", "evals/experiments/paired-v1/run.ps1"],
      "hard_gates": ["frozen_case_hash", "paired_config", "no_quality_regression"],
      "repeat": 5
    },
    {
      "id": "architecture-ablation",
      "stage": "release",
      "kind": "experiment",
      "description": "同运行时六变体消融，验证项目状态、数据契约、执行契约和证据链接的贡献。",
      "dimensions": ["context_fidelity", "task_success", "evidence_grounding", "tool_economy"],
      "owns": ["rust/crates/galen/src-tauri/src/architecture_variant.rs", "evals/experiments/architecture-v1/**"],
      "required_paths": ["evals/experiments/architecture-v1/matrix.json", "evals/experiments/architecture-v1/suite_manifest.json", "scripts/validate_architecture_run.py"],
      "hard_gates": ["six_variants_complete", "matrix_hash", "no_dry_run", "all_cases_present"],
      "repeat": 5
    },
    {
      "id": "ui-journey",
      "stage": "release",
      "kind": "command",
      "description": "导入、人工复核、派生状态、评测展示和 Artifact 预览的浏览器旅程。",
      "dimensions": ["delivery_integrity", "state_safety"],
      "owns": ["rust/crates/galen/src/**/*.tsx", "scripts/evals/*ui*", "scripts/evals/*journey*"],
      "command": {
        "cwd": ".",
        "argv": ["powershell", "-ExecutionPolicy", "Bypass", "-File", "scripts/evals/run_galen_ui_e2e.ps1"]
      },
      "required_paths": ["scripts/evals/run_galen_ui_e2e.ps1", "scripts/evals/galen_ui_journey.js"],
      "hard_gates": ["journey_complete", "zero_console_errors", "artifact_preview"]
    }
  ]
}
