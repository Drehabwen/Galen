{
  "schema_version": 1,
  "contract_id": "scienceagentbench-clintox-v3",
  "benchmark": "ScienceAgentBench",
  "instance_id": 1,
  "task": "clintox_nn",
  "runtime": {
    "platform": "linux-container",
    "working_directory": "/testbed",
    "benchmark_root": "/testbed/benchmark",
    "hardware": "cpu"
  },
  "generation": {
    "phase": "code_generation",
    "runtime_paths_available_now": false,
    "workspace_rule": "Only program.py and task-contract.json exist in the generation workspace. Do not probe /testbed paths during generation; encode them for future runtime use.",
    "submission_checks": [
      "program.py parses as Python",
      "all referenced dependency symbols appear in capabilities.available_symbols",
      "prediction extraction follows prediction_semantics",
      "invalid molecule handling follows data_quality.invalid_molecule_policy"
    ]
  },
  "capabilities": {
    "python": "3.10",
    "deepchem": "2.8.0",
    "available_symbols": [
      "deepchem.models.MultitaskClassifier",
      "deepchem.data.CSVLoader",
      "deepchem.feat.CircularFingerprint"
    ],
    "unavailable_symbols": [
      "deepchem.models.torch_models.MultitaskClassifier"
    ]
  },
  "dataset": {
    "relative_path": "datasets/clintox",
    "runtime_path": "/testbed/benchmark/datasets/clintox",
    "train_file": "clintox_train.csv",
    "test_file": "clintox_test.csv",
    "feature_column": "smiles",
    "target_columns": ["FDA_APPROVED", "CT_TOX"]
  },
  "output": {
    "relative_path": "pred_results/clintox_test_pred.csv",
    "required_columns": ["smiles", "FDA_APPROVED", "CT_TOX"],
    "row_order": "must match clintox_test.csv exactly"
  },
  "prediction_semantics": {
    "raw_tensor_axes": ["sample", "task", "class"],
    "required_value": "positive-class probability for each task",
    "required_extraction": "predictions[:, :, 1] when the raw tensor has three axes",
    "output_task_order": ["FDA_APPROVED", "CT_TOX"]
  },
  "data_quality": {
    "fingerprint": {
      "type": "ECFP",
      "size": 1024,
      "dtype": "float32"
    },
    "invalid_molecule_policy": {
      "processing_unit": "one input row at a time",
      "required_feature_shape": [1024],
      "final_fallback": "all-zero float32 vector",
      "intermediate_fallbacks_allowed": [
        "label-independent relaxed RDKit parsing"
      ],
      "preserve_train_rows": true,
      "preserve_test_rows": true,
      "preserve_test_order": true,
      "log_fallback_counts_to": "stderr",
      "label_independent": true
    }
  },
  "evaluation": {
    "relative_path": "eval_programs/clintox_nn_eval.py",
    "metric": "multitask ROC-AUC",
    "threshold": 0.77,
    "gates": [
      "program exits with status 0",
      "output file exists",
      "output smiles match test rows in order",
      "ROC-AUC is at least 0.77"
    ]
  },
  "stop_conditions": {
    "success": "all evaluation gates pass",
    "failure": "stop immediately when a required input or output contract is missing"
  }
}
