{
  "$schema": "https://raw.githubusercontent.com/nicepkg/vscode-tauri/main/schemas/tauri.conf.schema.json",
  "productName": "Galen",
  "version": "0.1.3",
  "identifier": "com.galen.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Galen — 医学科研助手",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 550,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/typst",
      "binaries/deno",
      "binaries/uv"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "compression": "zlib"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERERkVBRUREMTA5MDA0MgpSV1JDQUFuUjdlcmZEUWdBNktxU1puK0phSU04eFQvL3dXMzdqNnNTeVBrbVRuclZpSmluVlV1Rgo=",
      "endpoints": [
        "https://github.com/Drehabwen/Galen/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
